--
-- Idris2 package for the frame-v1 ABI contract (Face A).
--
-- From this directory: idris2 --typecheck FrameAbi.ipkg
-- Full F0.1 extraction/equivalence gate: bash scripts/atoma-check-idris.sh
--
-- `depends = base` only: the contract must not depend on libraries whose
-- semantics are themselves unproved.

package frameabi

version = 0.1.0
authors = "Jonathan D.A. Jewell"
brief = "Normative Atoma ABI contract for the frame-v1 worked example"

sourcedir = "."

depends = base

modules = FrameAbi, Linearity, Extract
