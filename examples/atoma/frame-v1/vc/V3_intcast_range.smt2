; generated by `atoma vc` - V3_intcast_range (cast)
; a slice from a u32 in_len is at most 2^32-1 bytes and at least 12, so the usize-to-u32 @intCast cannot trap
; expected: UNSAT
(set-logic QF_BV)
(declare-const buf_len_usize (_ BitVec 64))
(assert (bvule #x000000000000000c buf_len_usize))
(assert (bvule buf_len_usize #x00000000ffffffff))
(assert (not (bvule (bvsub buf_len_usize #x000000000000000c) #x00000000ffffffff)))
(check-sat)
