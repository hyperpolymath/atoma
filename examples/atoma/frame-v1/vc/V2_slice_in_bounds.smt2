; SPDX-License-Identifier: MPL-2.0
; generated by `atoma vc` - V2_slice_in_bounds (bounds)
; 12 + length <= buf.len, so buf[12 .. 12+length] is in bounds
; expected: UNSAT
(set-logic QF_BV)
(declare-const buf_len (_ BitVec 32))
(declare-const length (_ BitVec 32))
(assert (bvule #x0000000c buf_len))
(assert (bvule length (bvsub buf_len #x0000000c)))
(assert (not (bvule (bvadd #x0000000c length) buf_len)))
(check-sat)
