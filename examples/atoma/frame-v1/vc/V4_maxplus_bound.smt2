; generated by `atoma vc` - V4_maxplus_bound (cost)
; 8 steps per payload byte; worst case 8*65535+12 < 2^32 so the MaxPlus bound is representable in the cost domain
; expected: UNSAT
(set-logic QF_BV)
(declare-const steps (_ BitVec 32))
(declare-const payload_len (_ BitVec 32))
(assert (bvule payload_len #x0000ffff))
(assert (bvule steps (bvadd (bvmul #x00000008 payload_len) #x0000000c)))
(assert (not (bvule steps (bvadd (bvmul #x00000008 #x0000ffff) #x0000000c))))
(check-sat)
